@model FoodSafety.Domain.Models.FollowUp

@{
    ViewData["Title"] = "Create Follow Up";
}

<h1>Create Follow Up</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="InspectionId" class="control-label">Failed Inspection</label>
                <select asp-for="InspectionId" class="form-control" asp-items="ViewBag.InspectionId">
                    <option value="">-- Select Inspection --</option>
                </select>
                <span asp-validation-for="InspectionId" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="DueDate" class="control-label"></label>
                <input asp-for="DueDate" class="form-control" type="date" />
                <span asp-validation-for="DueDate" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
